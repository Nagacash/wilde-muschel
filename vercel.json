{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/feed.xml",              "destination": "/api/feed" },
    { "source": "/rss.xml",               "destination": "/api/feed" },
    { "source": "/podcast/feed",          "destination": "/api/feed" },
    { "source": "/((?!api/|episodes/).*)", "destination": "/index.html" }
  ]
}
